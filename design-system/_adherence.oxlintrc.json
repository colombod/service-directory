      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|search|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: size, search."
