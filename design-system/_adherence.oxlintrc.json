        "selector": "JSXOpeningElement[name.name='SessionPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|bell|onClick|key|ref|className|style|children)$/]",
        "message": "<SessionPill> doesn't accept that prop. Declared props: label, bell, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|preview|bellCount|edgeBell|deviceTag|loading|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SessionTile> doesn't accept that prop. Declared props: name, meta, preview, bellCount, edgeBell, deviceTag, loading, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|children|key|ref|className|style|children)$/]",
        "message": "<SettingsPanel> doesn't accept that prop. Declared props: open, title, onClose, children."
