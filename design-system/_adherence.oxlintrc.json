      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:filter|sm|md)$/]",
        "message": "<TextInput> size must be one of 'filter' | 'sm' | 'md'."
