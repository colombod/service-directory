{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/amplifier_app/**",
              "components/catalogue/**",
              "components/directory_core/**",
              "components/muxplex_core/**",
              "components/muxplex_overlay/**",
              "components/muxplex_session/**",
              "components/settings/**",
              "components/viewer/**",
              "ui_kits/amplifier_app/**",
              "ui_kits/muxplex/**",
              "ui_kits/registry_amplifier/**",
              "ui_kits/service_directory/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fira Code|Urbanist))/i]",
        "message": "Font not provided by the design system. Available: Fira Code, Urbanist."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddressLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|variant|key|ref|className|style|children)$/]",
        "message": "<AddressLink> doesn't accept that prop. Declared props: label, href, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddressLink'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<AddressLink> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmpAgentMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|text|key|ref|className|style|children)$/]",
        "message": "<AmpAgentMessage> doesn't accept that prop. Declared props: from, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmpHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:appName|markSrc|attention|attentionNoun|onAgent|agentOpen|children|style|key|ref|className|style|children)$/]",
        "message": "<AmpHeader> doesn't accept that prop. Declared props: appName, markSrc, attention, attentionNoun, onAgent, agentOpen, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmpTextControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:expanded|key|ref|className|style|children)$/]",
        "message": "<AmpTextControl> doesn't accept that prop. Declared props: expanded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmpTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|statusTone|summary|preview|tag|attention|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<AmpTile> doesn't accept that prop. Declared props: name, status, statusTone, summary, preview, tag, attention, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<CategoryChip> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|open|children|style|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: title, open, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|hint|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onValueChange|onClear|caption|key|ref|className|style|children)$/]",
        "message": "<FilterInput> doesn't accept that prop. Declared props: value, onValueChange, onClear, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|children|key|ref|className|style|children)$/]",
        "message": "<HeaderButton> doesn't accept that prop. Declared props: variant, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|agent|commit)$/]",
        "message": "<HeaderButton> variant must be one of 'default' | 'agent' | 'commit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<HealthPill> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:up|down|unknown)$/]",
        "message": "<HealthPill> status must be one of 'up' | 'down' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='JsonTree'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|style|key|ref|className|style|children)$/]",
        "message": "<JsonTree> doesn't accept that prop. Declared props: data, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|baseUrl|reachable|onRemove|last|key|ref|className|style|children)$/]",
        "message": "<PeerItem> doesn't accept that prop. Declared props: name, baseUrl, reachable, onRemove, last."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeerItem'] > JSXAttribute[name.name='reachable'] > Literal[value!=/^(?:up|unknown)$/]",
        "message": "<PeerItem> reachable must be one of 'up' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|expanded|caption|children|key|ref|className|style|children)$/]",
        "message": "<QuickLink> doesn't accept that prop. Declared props: as, expanded, caption, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickLink'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<QuickLink> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:service|status|onOpenHere|key|ref|className|style|children)$/]",
        "message": "<ServiceDetail> doesn't accept that prop. Declared props: service, status, onOpenHere."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceDetail'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:up|down|unknown)$/]",
        "message": "<ServiceDetail> status must be one of 'up' | 'down' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|host|url|key|ref|className|style|children)$/]",
        "message": "<ServiceLink> doesn't accept that prop. Declared props: label, host, url."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:origin|description|children|style|key|ref|className|style|children)$/]",
        "message": "<NodeGroup> doesn't accept that prop. Declared props: origin, description, children, style."
      },
