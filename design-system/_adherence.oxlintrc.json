      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|active|bell|preview|badge|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: name, active, bell, preview, badge, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|padded|key|ref|className|style|children)$/]",
        "message": "<Surface> doesn't accept that prop. Declared props: as, padded."
